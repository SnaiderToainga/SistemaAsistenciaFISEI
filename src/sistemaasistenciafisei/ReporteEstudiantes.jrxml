<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" 
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" 
              name="ReporteEstudiantes" 
              pageWidth="595" pageHeight="842" 
              columnWidth="535" 
              leftMargin="30" rightMargin="30" 
              topMargin="30" bottomMargin="30"
              uuid="b4e1f7a2-9c3d-4e5f-a6b7-8c9d0e1f2a3b">
    <property name="ireport.zoom" value="1.0"/>
    <property name="ireport.x" value="0"/>
    <property name="ireport.y" value="0"/>
    <parameter name="idMateria" class="java.lang.Integer">
        <defaultValueExpression><![CDATA[1]]></defaultValueExpression>
    </parameter>
    <parameter name="nombreMateria" class="java.lang.String">
        <defaultValueExpression><![CDATA["Computación Visual"]]></defaultValueExpression>
    </parameter>
    <parameter name="parcial" class="java.lang.String">
        <defaultValueExpression><![CDATA["Parcial 1"]]></defaultValueExpression>
    </parameter>
    <parameter name="totalSesiones" class="java.lang.Integer">
        <defaultValueExpression><![CDATA[5]]></defaultValueExpression>
    </parameter>
    <parameter name="totalSesionesP2" class="java.lang.Integer">
        <defaultValueExpression><![CDATA[5]]></defaultValueExpression>
    </parameter>
    <queryString>
        <![CDATA[SELECT e.cedula, 
       CONCAT(e.nombres, ' ', e.apellidos) AS nombre_completo,
       CASE 
           WHEN $P{parcial} = 'Promedio Final' THEN 
               CONCAT(
                   SUM(CASE WHEN a.parcial IN ('Parcial 1', 'Parcial 2') THEN 1 ELSE 0 END),
                   ' / ',
                   ($P{totalSesiones} + $P{totalSesionesP2})
               )
           ELSE 
               CONCAT(COUNT(a.id), ' / ', $P{totalSesiones})
       END AS asistencias_str,
       CASE 
           WHEN $P{parcial} = 'Promedio Final' THEN 
               CONCAT(ROUND((
                   ((SUM(CASE WHEN a.parcial = 'Parcial 1' THEN 1 ELSE 0 END) / ($P{totalSesiones} * 1.0)) * 100.0) +
                   ((SUM(CASE WHEN a.parcial = 'Parcial 2' THEN 1 ELSE 0 END) / ($P{totalSesionesP2} * 1.0)) * 100.0)
               ) / 2.0, 1), '%')
           ELSE 
               CONCAT(ROUND((COUNT(a.id) / ($P{totalSesiones} * 1.0)) * 100.0, 1), '%')
       END AS porcentaje_str,
       CASE 
           WHEN (
               CASE 
                   WHEN $P{parcial} = 'Promedio Final' THEN (
                       ((SUM(CASE WHEN a.parcial = 'Parcial 1' THEN 1 ELSE 0 END) / ($P{totalSesiones} * 1.0)) * 100.0) +
                       ((SUM(CASE WHEN a.parcial = 'Parcial 2' THEN 1 ELSE 0 END) / ($P{totalSesionesP2} * 1.0)) * 100.0)
                   ) / 2.0
                   ELSE ((COUNT(a.id) / ($P{totalSesiones} * 1.0)) * 100.0)
               END
           ) >= 80 THEN 'APROBADO'
           WHEN (
               CASE 
                   WHEN $P{parcial} = 'Promedio Final' THEN (
                       ((SUM(CASE WHEN a.parcial = 'Parcial 1' THEN 1 ELSE 0 END) / ($P{totalSesiones} * 1.0)) * 100.0) +
                       ((SUM(CASE WHEN a.parcial = 'Parcial 2' THEN 1 ELSE 0 END) / ($P{totalSesionesP2} * 1.0)) * 100.0)
                   ) / 2.0
                   ELSE ((COUNT(a.id) / ($P{totalSesiones} * 1.0)) * 100.0)
               END
           ) >= 70 THEN 'EN RIESGO'
           ELSE 'REPROBADO'
       END AS estado_academico
FROM estudiantes e
INNER JOIN matriculas m ON e.id = m.id_estudiante AND m.id_materia = $P{idMateria}
LEFT JOIN asistencias a ON e.id = a.id_estudiante
     AND a.id_materia = $P{idMateria}
     AND (($P{parcial} = 'Promedio Final' AND a.parcial IN ('Parcial 1', 'Parcial 2')) OR a.parcial = $P{parcial})
     AND a.estado = 'PRESENTE'
GROUP BY e.id, e.cedula, e.nombres, e.apellidos
ORDER BY e.apellidos ASC, e.nombres ASC;]]>
    </queryString>
    <field name="cedula" class="java.lang.String"/>
    <field name="nombre_completo" class="java.lang.String"/>
    <field name="asistencias_str" class="java.lang.String"/>
    <field name="porcentaje_str" class="java.lang.String"/>
    <field name="estado_academico" class="java.lang.String"/>
